x="176.0" y="1017"/></Array></mxGeometry></mxCell><mxCell id="c30" value="10: aplicarAgingEnCola()" style="text;html=1;align=left;verticalAlign=bottom;whiteSpace=nowrap;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="134.0" y="973" width="300" height="20" as="geometry"/></mxCell><mxCell id="c31" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="pedido"><mxGeometry x="80.0" y="995" width="10" height="30" as="geometry"/></mxCell><mxCell id="e32" value="11: actualizarEstado(GATEWAY_ASIGNADO)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12;endArrow=block;endFill=1;endSize=8;exitX=1;exitY=0.899;exitDx=0;exitDy=0;entryX=0;entryY=0.3333;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c33" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="op"><mxGeometry x="10.0" y="1050" width="10" height="40" as="geometry"/></mxCell><mxCell id="e34" value="12: notificarAsignacion(idGateway)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12;endArrow=open;endFill=0;endSize=12;exitX=1;exitY=0.9519;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c33"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c35" value="&lt;b&gt;RN-08&lt;/b&gt; — El Gateway 5 es de uso exclusivo para carga de construcción. El sistema nunca lo asigna a carga general, aunque sea la única bahía libre." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spac