dth=1.2;fontFamily=Helvetica;fontSize=12;endArrow=block;endFill=1;endSize=8;exitX=1;exitY=0.7394;exitDx=0;exitDy=0;entryX=0;entryY=0.2857;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="pedido"><mxGeometry x="80.0" y="930" width="10" height="35" as="geometry"/></mxCell><mxCell id="e30" value="11: actualizarEstado(EN_COLA)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12;endArrow=block;endFill=1;endSize=8;exitX=0;exitY=0.8085;exitDx=0;exitDy=0;entryX=1;entryY=0.2857;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="html=1;points=[];perimeter=orthogonalPerimeter;outlineConnect=0;targetShapes=umlLifeline;portConstraint=eastwest;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="motor"><mxGeometry x="80.0" y="995" width="10" height="55" as="geometry"/></mxCell><mxCell id="e32" value="12: encolarRegistro(registro)" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12;endArrow=open;endFill=0;endSize=12;exitX=1;exitY=0.8777;exitDx=0;exitDy=0;entryX=0;entryY=0.1818;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e33" value="13: clasificacionPuntualidad : EnumPuntualidad" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12;endArrow=open;endFill=0;dashed=1;endSize=8;fontColor=#333333;exitX=0;exitY=0.9894;exitDx=0;exitDy=0;entryX=1;entryY=0.981;entryDx=0;entryDy=0;" edge="1" parent="1" source="c11" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c34" value="&lt;b&gt;RN-04&lt;/b&gt; — La ventana de tolerancia es un parámetro configurable (ParametroSistema.ventanaToleranciaMin = 15 min). El timestamp de llegada lo toma el servidor, no el cliente, para garantizar la trazabilidad del arribo." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1555.0" y="280" width="260" height="110" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;alt&lt;/b&gt; — Las tres ramas detallan el resultado interno de calcularClasificacion(); no son mensajes adicionales." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1555.0" y="560" width="260" height="80" as="geometry"/></mxCell><mxCell id="c36" value="&lt;b&gt;Mensaje 12 asíncrono&lt;/b&gt; (punta abierta): el motor de colas de EDA 0 recibe el registro y lo procesa sin bloquear la pantalla de garita." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontFamily=Helvetica;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1555.0" y="1040" width="260" height="90" as="geometry"/></mxCell><mxCell id="e37" value="" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12;endArrow=block;endFill=1;endSize=8;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1285" as="sourcePoint"/><mxPoint x="150" y="1285" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="Síncrono" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="160" y="1275" width="140" height="20" as="geometry"/></mxCell><mxCell id="e39" value="" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12;endArrow=open;endFill=0;dashed=1;endSize=8;fontColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="320" y="1285" as="sourcePoint"/><mxPoint x="410" y="1285" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c40" value="Retorno" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="1275" width="140" height="20" as="geometry"/></mxCell><mxCell id="e41" value="" style="html=1;verticalAlign=bottom;labelBackgroundColor=none;strokeWidth=1.2;fontFamily=Helvetica;fontSize=12;endArrow=open;endFill=0;endSize=12;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="1285" as="sourcePoint"/><mxPoint x="670" y="1285" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c42" value="Asíncrono" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="1275" width="140" height="20" as="geometry"/></mxCell><mxCell id="c43" value="[ horaLlegadaReal &amp;lt; inicio de la ventana ]" style="text;html=1;align=left;verticalAlign=middle;fontStyle=2;whiteSpace=nowrap;labelBackgroundColor=#ffffff;spacing=0;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="545" y="537" width="10" height="18" as="geometry"/></mxCell><mxCell id="c44" value="[ horaLlegadaReal dentro de ventana + toleranciaMin ]" style="text;html=1;align=left;verticalAlign=middle;fontStyle=2;whiteSpace=nowrap;labelBackgroundColor=#ffffff;spacing=0;fontFamily=Helvetica;fontSize=12;" vertex="1" parent="1"><mxGeometry x="545" y="627" width="10" height="18" as="geometry"/></mxCell><mxCell id="c45" value="[ horaLlegadaReal &