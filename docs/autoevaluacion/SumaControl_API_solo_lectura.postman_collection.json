{
  "info": {
    "name": "SumaControl API — Grupo N.º 1 (solo lectura)",
    "description": "Versión segura de la colección: solo el login y las solicitudes GET. No crea, modifica ni borra datos. Cada solicitud verifica tiempo < 200 ms y ausencia de error 500. Ejecutar completa con el Collection Runner o con newman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "correo",
      "value": "admin@sumacontrol.test"
    },
    {
      "key": "password",
      "value": "CAMBIAR"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "tempToken",
      "value": ""
    },
    {
      "key": "proveedorId",
      "value": ""
    },
    {
      "key": "pedidoId",
      "value": ""
    },
    {
      "key": "gatewayId",
      "value": ""
    },
    {
      "key": "descargaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "00 Salud",
      "description": "",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Tiempo de respuesta < 200 ms (RNF-02)\", function () { pm.expect(pm.response.responseTime).to.be.below(200); });",
                  "pm.test(\"Sin error de servidor (< 500)\", function () { pm.expect(pm.response.code).to.be.below(500); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "01 Autenticación (HU-004)",
      "description": "",
      "item": [
        {
          "name": "POST /api/auth/login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "description": "Devuelve token ACCESS, o mfaRequired/tempToken si hay segundo factor. Guarda el token en la variable de colección.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correo}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) { pm.collectionVariables.set(\"token\", j.token); }",
                  "if (j.tempToken) { pm.collectionVariables.set(\"tempToken\", j.tempToken); }",
                  "pm.test(\"Tiempo de respuesta < 200 ms (RNF-02)\", function () { pm.expect(pm.response.responseTime).to.be.below(200); });",
                  "pm.test(\"Sin error de servidor (< 500)\", function () { pm.expect(pm.response.code).to.be.below(500); });"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/auth/perfil",
